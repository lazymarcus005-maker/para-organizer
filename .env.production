# PARA Organizer — Production Environment
# 
# IMPORTANT: Never commit .env to Git
# Use this template and fill in production values
# Then copy: cp .env.production .env
#
# Generated: 2025-07-26

# ────────────────── CORE ──────────────────
PARA_PORT=8731
PARA_DB_PATH=/var/lib/para-organizer/data/para.db
PARA_SECRET_KEY=CHANGE_ME_TO_RANDOM_32_CHAR_STRING

# ────────────────── LLM (Ollama Cloud) ──────────────────
# Get key from: https://ollama.com/account/api-keys
OLLAMA_API_KEY=CHANGE_ME
OLLAMA_BASE_URL=https://ollama.com/v1
LLM_PRIMARY=deepseek-v4-flash
LLM_FALLBACK=gpt-oss:20b
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ────────────────── Telegram Bot ──────────────────
# Get token from: https://t.me/BotFather (create new bot)
# Format: 123456:ABCDEFxxxx
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_WEBHOOK_URL=https://para.mxlabs.cloud/webhook/telegram
# List of allowed user IDs (comma-separated, e.g. "123456789,987654321")
TELEGRAM_ALLOWED_USERS=CHANGE_ME

# ────────────────── Notifications ──────────────────
NOTIFY_CHANNEL=telegram
NOTIFY_DEADLINE_DAYS=7,3,1
NOTIFY_DIGEST_DAY=mon
NOTIFY_DIGEST_TIME=08:00
NOTIFY_STALE_DAYS=14

# ────────────────── Auto-Maintenance ──────────────────
AUTO_ARCHIVE_DAYS=30
RECLASSIFY_INTERVAL_HOURS=6
RECLASSIFY_CONFIDENCE_THRESHOLD=0.7

# ────────────────── Web ──────────────────
WEB_PUBLIC_URL=https://para.mxlabs.cloud
